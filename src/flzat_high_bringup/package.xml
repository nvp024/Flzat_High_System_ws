<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flzat_high_bringup</name>
  <version>0.2.0</version>
  <description>Launch, fixtures and mock ROS nodes for FLZAT High System.</description>
  <maintainer email="high-system@example.com">FLZAT High System</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>flzat_cognitive_pipeline</depend>
  <depend>flzat_high_interfaces</depend>
  <depend>flzat_memory</depend>
  <depend>flzat_speech</depend>
  <depend>flzat_vision_context</depend>
  <depend>flzat_vlm</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
