# Keep source and configuration files consistent across Linux/cloud machines.
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
# Runtime model weights are versioned through Git LFS.
*.pt filter=lfs diff=lfs merge=lfs -text
*.jit filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
# Other binary assets.
*.png -text
*.jpg -text
*.jpeg -text
*.pgm -text
*.wav -text
